<!DOCTYPE html>
<html lang="en">
<head><script>
  let correctPassword = 'awon';
  let userInput = prompt('Please enter the password to access this site:');
  if (userInput !== correctPassword) {
    document.body.innerHTML = '<h1>Access Denied</h1>';
    window.stop();
  }
</script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AS WiFi Service - Recharge & Cycle Manager</title>
    
    <!-- PWA & Mobile Home Screen Meta Tags -->
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="AS WiFi">
    <meta name="application-name" content="AS WiFi Service">
    
    <!-- Embedded SVG App Icon for Home Screen -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%232563eb'/%3E%3Cpath d='M50 72a6 6 0 1 0 0 12 6 6 0 0 0 0-12zm-18-13a26 26 0 0 1 36 0l-5 5a19 19 0 0 0-26 0l-5-5zm-12-12a43 43 0 0 1 60 0l-5 5a36 36 0 0 0-50 0l-5-5zm-12-12a60 60 0 0 1 84 0l-5 5a53 53 0 0 0-74 0l-5-5z' fill='%23ffffff'/%3E%3C/svg%3E">
    <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%232563eb'/%3E%3Cpath d='M50 72a6 6 0 1 0 0 12 6 6 0 0 0 0-12zm-18-13a26 26 0 0 1 36 0l-5 5a19 19 0 0 0-26 0l-5-5zm-12-12a43 43 0 0 1 60 0l-5 5a36 36 0 0 0-50 0l-5-5zm-12-12a60 60 0 0 1 84 0l-5 5a53 53 0 0 0-74 0l-5-5z' fill='%23ffffff'/%3E%3C/svg%3E">

    <!-- Web App Manifest (Data URI for Installability) -->
    <link rel="manifest" id="pwa-manifest">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome for crisp icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
            -webkit-tap-highlight-color: transparent;
        }
        /* Custom scrollbar for horizontal filter pills */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Smooth modal transitions */
        .modal-backdrop {
            transition: opacity 0.2s ease-out;
        }
        .modal-panel {
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease-out;
        }
    </style>
</head>
<body class="text-slate-800 antialiased pb-24">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 text-white sticky top-0 z-30 shadow-md">
        <div class="max-w-3xl mx-auto px-4 py-3.5 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center shadow-inner shadow-blue-400/30">
                    <i class="fa-solid fa-wifi text-lg text-white"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight leading-tight">AS WiFi Service</h1>
                    <p class="text-[11px] text-slate-400 font-medium" id="header-date-display">Loading date...</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button onclick="openBackupModal()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 active:scale-95 transition text-xs font-semibold text-slate-200 flex items-center gap-1.5 border border-slate-700" title="Backup & Gmail Sync">
                    <i class="fa-solid fa-cloud-arrow-up text-emerald-400"></i>
                    <span class="hidden sm:inline">Backup</span>
                </button>
                <button onclick="openInstallModal()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 active:scale-95 transition text-xs font-semibold text-slate-200 flex items-center gap-1.5 border border-slate-700" title="Add to Home Screen">
                    <i class="fa-solid fa-mobile-screen-button text-blue-400"></i>
                    <span class="hidden sm:inline">Install App</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Single-Page Container -->
    <main class="max-w-3xl mx-auto px-4 pt-4 space-y-5">

        <!-- 4-Card Live Summary Dashboard -->
        <section aria-label="Dashboard Summary" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <!-- Total Customers -->
            <div onclick="setFilter('all')" class="cursor-pointer bg-white p-3.5 rounded-2xl shadow-sm border border-slate-200/80 hover:border-blue-300 transition active:scale-[0.99]">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-semibold text-slate-500">Total Customers</span>
                    <span class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-users"></i>
                    </span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900" id="stat-total-customers">0</div>
                <div class="text-[11px] text-slate-400 mt-0.5">Active list</div>
            </div>

            <!-- Needs Recharge Today / Due -->
            <div onclick="setFilter('due')" class="cursor-pointer bg-white p-3.5 rounded-2xl shadow-sm border border-amber-200/90 hover:border-amber-400 transition active:scale-[0.99] relative overflow-hidden">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-semibold text-amber-700">Needs Recharge</span>
                    <span class="w-7 h-7 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-bell"></i>
                    </span>
                </div>
                <div class="text-2xl font-extrabold text-amber-600" id="stat-due-today">0</div>
                <div class="text-[11px] text-amber-700/80 mt-0.5 font-medium">Current pack expired</div>
            </div>

            <!-- Recharged Today -->
            <div onclick="setFilter('today')" class="cursor-pointer bg-white p-3.5 rounded-2xl shadow-sm border border-slate-200/80 hover:border-emerald-300 transition active:scale-[0.99]">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-semibold text-slate-500">Recharged Today</span>
                    <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-bolt"></i>
                    </span>
                </div>
                <div class="text-2xl font-extrabold text-emerald-600" id="stat-recharged-today">0</div>
                <div class="text-[11px] text-slate-400 mt-0.5">Updated today</div>
            </div>

            <!-- Total Days Owed -->
            <div onclick="setFilter('pending')" class="cursor-pointer bg-white p-3.5 rounded-2xl shadow-sm border border-slate-200/80 hover:border-indigo-300 transition active:scale-[0.99]">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-semibold text-slate-500">Days Owed</span>
                    <span class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-calendar-day"></i>
                    </span>
                </div>
                <div class="text-2xl font-extrabold text-indigo-600" id="stat-total-pending-days">0</div>
                <div class="text-[11px] text-slate-400 mt-0.5">Total days remaining</div>
            </div>
        </section>

        <!-- Search & Primary Add Action Bar -->
        <section class="bg-white p-3.5 rounded-2xl shadow-sm border border-slate-200/80 space-y-3">
            <div class="flex flex-col sm:flex-row gap-2.5">
                <!-- Search Box -->
                <div class="relative flex-1">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input 
                        type="text" 
                        id="search-input" 
                        oninput="renderCustomers()" 
                        placeholder="Search by Name, Book No, or App ID..." 
                        class="w-full pl-10 pr-9 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition"
                    >
                    <button id="clear-search-btn" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>

                <!-- Add New Customer Button -->
                <button onclick="openCustomerModal()" class="bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-sm shadow-blue-600/20 flex items-center justify-center gap-2 transition shrink-0">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add Customer</span>
                </button>
            </div>

            <!-- Filter Pills -->
            <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-0.5">
                <button onclick="setFilter('all')" id="filter-all" class="filter-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap bg-slate-900 text-white">
                    All (<span id="count-all">0</span>)
                </button>
                <button onclick="setFilter('due')" id="filter-due" class="filter-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
                    <i class="fa-solid fa-clock text-amber-500 mr-1"></i>Needs Top-Up (<span id="count-due">0</span>)
                </button>
                <button onclick="setFilter('pending')" id="filter-pending" class="filter-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
                    Has Days Left (<span id="count-pending">0</span>)
                </button>
                <button onclick="setFilter('today')" id="filter-today" class="filter-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
                    Recharged Today (<span id="count-today">0</span>)
                </button>
                <button onclick="setFilter('completed')" id="filter-completed" class="filter-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
                    Full 30/30 (<span id="count-completed">0</span>)
                </button>
            </div>
        </section>

        <!-- Customer List Container -->
        <section id="customer-list" class="space-y-3">
            <!-- Dynamic Customer Cards Injected Here -->
        </section>

        <!-- Empty State (Shown when no customers match) -->
        <div id="empty-state" class="hidden bg-white rounded-2xl p-8 text-center border border-slate-200/80 shadow-sm">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-2xl">
                <i class="fa-solid fa-router"></i>
            </div>
            <h3 class="text-base font-bold text-slate-800" id="empty-state-title">No customers added yet</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto" id="empty-state-desc">Tap "Add Customer" to record a customer's payment date, Book No, App ID, and track their 30-day WiFi recharge balance.</p>
            <button onclick="openCustomerModal()" class="mt-4 px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-xl hover:bg-blue-700 transition">
                + Add First Customer
            </button>
        </div>

        <!-- Footer Info & Removed History Trigger -->
        <footer class="pt-2 pb-6 text-center space-y-2">
            <div class="flex items-center justify-center gap-4 text-xs text-slate-500">
                <button onclick="openArchiveModal()" class="hover:text-slate-800 underline underline-offset-2 font-medium">
                    <i class="fa-solid fa-box-archive mr-1"></i>Completed/Removed History (<span id="archive-count">0</span>)
                </button>
                <span>•</span>
                <span class="text-emerald-600 font-medium"><i class="fa-solid fa-shield-check mr-1"></i>Auto-Saved Offline</span>
            </div>
            <p class="text-[11px] text-slate-400">AS WiFi Service • Permanent Local Storage Enabled</p>
        </footer>
    </main>

    <!-- Floating Mobile Quick-Add Button -->
    <button onclick="openCustomerModal()" aria-label="Add Customer" class="sm:hidden fixed bottom-5 right-5 z-20 w-14 h-14 rounded-full bg-blue-600 text-white shadow-lg shadow-blue-600/40 flex items-center justify-center text-xl active:scale-90 transition">
        <i class="fa-solid fa-plus"></i>
    </button>

    <!-- ===================================================================== -->
    <!-- MODAL 1: ADD / EDIT CUSTOMER                                          -->
    <!-- ===================================================================== -->
    <div id="customer-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/60 backdrop-blur-xs p-0 sm:p-4">
        <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden max-h-[92vh] flex flex-col">
            <!-- Modal Header -->
            <div class="px-5 py-4 bg-slate-900 text-white flex items-center justify-between shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-user-plus" id="modal-header-icon"></i>
                    </div>
                    <h2 class="text-base font-bold" id="customer-modal-title">Add New Customer</h2>
                </div>
                <button onclick="closeCustomerModal()" class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 hover:text-white flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Modal Form Body -->
            <form id="customer-form" onsubmit="saveCustomer(event)" class="p-5 overflow-y-auto space-y-4">
                <input type="hidden" id="edit-customer-id">

                <!-- Customer Name -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Customer Name <span class="text-red-500">*</span></label>
                    <input type="text" id="field-name" required placeholder="e.g., Rahim Uddin" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
                </div>

                <!-- Book No & App ID Row -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            <i class="fa-solid fa-book text-amber-600 mr-1"></i>Book No. (Khata) <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="field-book-no" required placeholder="e.g., 104" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            <i class="fa-solid fa-mobile-button text-blue-600 mr-1"></i>App ID / No. <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="field-app-id" required placeholder="e.g., 25" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
                    </div>
                </div>

                <!-- Payment Date & Last Recharge Date -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Bill Payment Date <span class="text-red-500">*</span></label>
                        <input type="date" id="field-payment-date" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Total Cycle Days</label>
                        <input type="number" id="field-total-days" min="1" max="32" value="30" required oninput="updateModalCalculation()" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
                    </div>
                </div>

                <!-- Days Recharged Section -->
                <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-bold text-slate-700">Total Days Recharged (1–32)</label>
                        <span class="text-[11px] font-semibold text-blue-600">Type or tap pills</span>
                    </div>

                    <div class="flex items-center gap-3">
                        <input type="number" id="field-recharged-days" min="0" max="32" value="0" required oninput="updateModalCalculation()" class="w-24 px-3 py-2 bg-white border border-slate-300 rounded-xl text-lg font-extrabold text-center text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        
                        <!-- Quick Set / Add Buttons -->
                        <div class="flex flex-wrap gap-1.5 flex-1">
                            <button type="button" onclick="setModalRechargedDays(0)" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-100">0d</button>
                            <button type="button" onclick="setModalRechargedDays(1)" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-700 hover:bg-blue-50 hover:border-blue-300">1d</button>
                            <button type="button" onclick="setModalRechargedDays(7)" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-700 hover:bg-blue-50 hover:border-blue-300">7d</button>
                            <button type="button" onclick="setModalRechargedDays(10)" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-700 hover:bg-blue-50 hover:border-blue-300">10d</button>
                            <button type="button" onclick="setModalRechargedDays(15)" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-700 hover:bg-blue-50 hover:border-blue-300">15d</button>
                            <button type="button" onclick="setModalRechargedDays(30)" class="px-2.5 py-1.5 rounded-lg bg-emerald-50 border border-emerald-200 text-xs font-bold text-emerald-700 hover:bg-emerald-100">30d</button>
                        </div>
                    </div>

                    <!-- Auto-Calculated Result Box -->
                    <div class="flex items-center justify-between pt-2 border-t border-slate-200/80">
                        <span class="text-xs font-semibold text-slate-600">Customer Will Still Get (Remaining):</span>
                        <span id="modal-remaining-preview" class="px-3 py-1 rounded-lg bg-amber-100 text-amber-800 text-sm font-extrabold">30 Days</span>
                    </div>
                </div>

                <!-- Optional Last Chunk Tracking (for automatic expiry alerts) -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Last Recharged On</label>
                        <input type="date" id="field-last-recharge-date" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Last Pack Days Given</label>
                        <input type="number" id="field-last-chunk-days" min="0" max="32" value="0" placeholder="e.g., 7" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>

                <!-- Submit Buttons -->
                <div class="pt-2 flex gap-2.5">
                    <button type="button" onclick="closeCustomerModal()" class="flex-1 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm transition">
                        Cancel
                    </button>
                    <button type="submit" class="flex-2 w-2/3 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md shadow-blue-600/20 transition">
                        Save Customer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL 2: QUICK TOP-UP / GIVE RECHARGE                                 -->
    <!-- ===================================================================== -->
    <div id="recharge-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/60 backdrop-blur-xs p-0 sm:p-4">
        <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden">
            <div class="px-5 py-4 bg-emerald-600 text-white flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold flex items-center gap-2">
                        <i class="fa-solid fa-bolt"></i> Give WiFi Recharge
                    </h3>
                    <p class="text-xs text-emerald-100 mt-0.5" id="recharge-customer-subtitle">Customer Name</p>
                </div>
                <button onclick="closeRechargeModal()" class="w-8 h-8 rounded-full bg-emerald-700/70 text-white flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <input type="hidden" id="recharge-customer-id">

                <!-- Current Balance Summary -->
                <div class="grid grid-cols-3 gap-2 bg-slate-50 p-3 rounded-2xl border border-slate-200 text-center">
                    <div>
                        <div class="text-[11px] text-slate-500 font-medium">Total Cycle</div>
                        <div class="text-base font-extrabold text-slate-800" id="rc-total">30d</div>
                    </div>
                    <div class="border-x border-slate-200">
                        <div class="text-[11px] text-slate-500 font-medium">Given So Far</div>
                        <div class="text-base font-extrabold text-blue-600" id="rc-given">0d</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-500 font-medium">Remaining</div>
                        <div class="text-base font-extrabold text-amber-600" id="rc-remaining">30d</div>
                    </div>
                </div>

                <!-- Quick Select Pills (1 to 32) -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-2">How many days are you recharging right now?</label>
                    <div class="grid grid-cols-4 gap-2 mb-3">
                        <button type="button" onclick="selectRechargeChunk(1)" class="py-2.5 rounded-xl bg-blue-50 hover:bg-blue-100 border border-blue-200 text-blue-700 font-extrabold text-sm transition">+1 Day</button>
                        <button type="button" onclick="selectRechargeChunk(7)" class="py-2.5 rounded-xl bg-blue-50 hover:bg-blue-100 border border-blue-200 text-blue-700 font-extrabold text-sm transition">+7 Days</button>

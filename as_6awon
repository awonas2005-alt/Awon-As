    <!-- ===================================================================== -->
    <!-- APPLICATION LOGIC (JAVASCRIPT)                                        -->
    <!-- ===================================================================== -->
    <script>
        // Storage Keys
        const STORAGE_KEY = 'as_wifi_service_customers_v1';
        const ARCHIVE_KEY = 'as_wifi_service_archive_v1';

        // Application State
        let customers = [];
        let archivedCustomers = [];
        let currentFilter = 'all';

        // Utility: Get Today's Date in YYYY-MM-DD (local timezone safe)
        function getTodayISO() {
            const now = new Date();
            const offset = now.getTimezoneOffset();
            const local = new Date(now.getTime() - (offset * 60 * 1000));
            return local.toISOString().split('T')[0];
        }

        // Utility: Format YYYY-MM-DD to readable DD-MM-YYYY
        function formatDisplayDate(isoDate) {
            if (!isoDate) return 'N/A';
            const parts = isoDate.split('-');
            if (parts.length !== 3) return isoDate;
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        // Utility: Calculate days difference between two ISO dates
        function daysBetween(startISO, endISO) {
            if (!startISO || !endISO) return 0;
            const start = new Date(startISO + 'T00:00:00');
            const end = new Date(endISO + 'T00:00:00');
            const diffTime = end - start;
            return Math.floor(diffTime / (1000 * 60 * 60 * 24));
        }

        // Utility: Add days to an ISO date string
        function addDaysToISO(isoDate, daysToAdd) {
            if (!isoDate) return '';
            const date = new Date(isoDate + 'T00:00:00');
            date.setDate(date.getDate() + Number(daysToAdd));
            const offset = date.getTimezoneOffset();
            const local = new Date(date.getTime() - (offset * 60 * 1000));
            return local.toISOString().split('T')[0];
        }

        // Check if a customer needs top-up today (current chunk expired AND still has remaining days owed)
        function isCustomerDueForTopUp(customer) {
            const remaining = Math.max(0, customer.totalDays - customer.rechargedDays);
            if (remaining <= 0) return false;

            // If 0 days recharged so far, they immediately need their first recharge!
            if (customer.rechargedDays === 0) return true;

            // If we have lastRechargeDate and lastChunkDays, check if that chunk has expired by today
            if (customer.lastRechargeDate && customer.lastChunkDays > 0) {
                const today = getTodayISO();
                const expiryDate = addDaysToISO(customer.lastRechargeDate, customer.lastChunkDays);
                return today >= expiryDate;
            }

            return false;
        }

        // Initialize App on Load
        window.onload = function () {
            setupPWAManifest();
            displayHeaderDate();
            loadDataFromStorage();
            renderCustomers();
        };

        // Generate Dynamic PWA Manifest for Add-to-Home-Screen
        function setupPWAManifest() {
            const manifest = {
                name: "AS WiFi Service",
                short_name: "AS WiFi",
                start_url: ".",
                display: "standalone",
                background_color: "#f1f5f9",
                theme_color: "#0f172a",
                description: "Customer 30-day WiFi recharge and cycle tracker for AS WiFi Service"
            };
            const stringManifest = JSON.stringify(manifest);
            const blob = new Blob([stringManifest], { type: 'application/json' });
            const manifestURL = URL.createObjectURL(blob);
            document.getElementById('pwa-manifest').setAttribute('href', manifestURL);
        }

        // Display Formatted Current Date in Header
        function displayHeaderDate() {
            const options = { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' };
            document.getElementById('header-date-display').textContent = new Date().toLocaleDateString('en-GB', options);
        }

        // Load Data Permanently from LocalStorage
        function loadDataFromStorage() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                const savedArchive = localStorage.getItem(ARCHIVE_KEY);
                customers = saved ? JSON.parse(saved) : [];
                archivedCustomers = savedArchive ? JSON.parse(savedArchive) : [];
            } catch (err) {
                console.error('Failed to load storage:', err);
                customers = [];
                archivedCustomers = [];
            }
        }

        // Save Data Permanently to LocalStorage
        function saveDataToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(customers));
                localStorage.setItem(ARCHIVE_KEY, JSON.stringify(archivedCustomers));
            } catch (err) {
                showToast('Warning: Storage space full!');
            }
        }

        // Show Toast Notification
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = msg;
            toast.classList.remove('hidden');
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                toast.classList.add('hidden');
            }, 2800);
        }

        // Update Dashboard & Filter Counters
        function updateDashboardStats() {
            const today = getTodayISO();
            let dueCount = 0;
            let todayCount = 0;
            let pendingCustomerCount = 0;
            let completedCount = 0;
            let totalPendingDays = 0;

            customers.forEach(c => {
                const remaining = Math.max(0, c.totalDays - c.rechargedDays);
                totalPendingDays += remaining;

                if (remaining > 0) pendingCustomerCount++;
                else completedCount++;

                if (isCustomerDueForTopUp(c)) dueCount++;
                if (c.lastRechargeDate === today && c.rechargedDays > 0) todayCount++;
            });

            // Top Stat Cards
            document.getElementById('stat-total-customers').textContent = customers.length;
            document.getElementById('stat-due-today').textContent = dueCount;
            document.getElementById('stat-recharged-today').textContent = todayCount;
            document.getElementById('stat-total-pending-days').textContent = totalPendingDays + 'd';

            // Filter Pill Counts
            document.getElementById('count-all').textContent = customers.length;
            document.getElementById('count-due').textContent = dueCount;
            document.getElementById('count-pending').textContent = pendingCustomerCount;
            document.getElementById('count-today').textContent = todayCount;
            document.getElementById('count-completed').textContent = completedCount;
            document.getElementById('archive-count').textContent = archivedCustomers.length;
        }

        // Set Active Filter Tab
        function setFilter(filterName) {
            currentFilter = filterName;
            document.querySelectorAll('.filter-pill').forEach(btn => {
                btn.classList.remove('bg-slate-900', 'text-white');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            });
            const activeBtn = document.getElementById(`filter-${filterName}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-100', 'text-slate-600');
                activeBtn.classList.add('bg-slate-900', 'text-white');
            }
            renderCustomers();
        }

        // Clear Search Input
        function clearSearch() {
            document.getElementById('search-input').value = '';
            renderCustomers();
        }

        // Render Customer Cards
        function renderCustomers() {
            updateDashboardStats();

            const listEl = document.getElementById('customer-list');
            const emptyEl = document.getElementById('empty-state');
            const searchInput = document.getElementById('search-input');
            const clearBtn = document.getElementById('clear-search-btn');
            const query = searchInput.value.trim().toLowerCase();
            const today = getTodayISO();

            clearBtn.classList.toggle('hidden', query.length === 0);

            // Filter customers
            let filtered = customers.filter(c => {
                const remaining = Math.max(0, c.totalDays - c.rechargedDays);
                const matchesSearch = !query ||
                    c.name.toLowerCase().includes(query) ||
                    String(c.bookNo).toLowerCase().includes(query) ||
                    String(c.appId).toLowerCase().includes(query);

                if (!matchesSearch) return false;

                if (currentFilter === 'due') return isCustomerDueForTopUp(c);
                if (currentFilter === 'pending') return remaining > 0;
                if (currentFilter === 'today') return c.lastRechargeDate === today && c.rechargedDays > 0;
                if (currentFilter === 'completed') return remaining === 0;
                return true;
            });

            // Sort: Due customers first, then customers with remaining days, then newest
            filtered.sort((a, b) => {
                const dueA = isCustomerDueForTopUp(a) ? 1 : 0;
                const dueB = isCustomerDueForTopUp(b) ? 1 : 0;
                if (dueB !== dueA) return dueB - dueA;
                return b.updatedAt - a.updatedAt;
            });

            if (filtered.length === 0) {
                listEl.innerHTML = '';
                emptyEl.classList.remove('hidden');
                if (customers.length > 0) {
                    document.getElementById('empty-state-title').textContent = 'No matching customers found';
                    document.getElementById('empty-state-desc').textContent = 'Try clearing your search or switching filter tabs.';
                } else {
                    document.getElementById('empty-state-title').textContent = 'No customers added yet';
                    document.getElementById('empty-state-desc').textContent = 'Tap "Add Customer" to record a customer\'s payment date, Book No, App ID, and track their 30-day WiFi recharge balance.';
                }
                return;
            }

            emptyEl.classList.add('hidden');

            listEl.innerHTML = filtered.map(c => {
                const remaining = Math.max(0, c.totalDays - c.rechargedDays);
                const percent = Math.min(100, Math.round((c.rechargedDays / c.totalDays) * 100));
                const isDue = isCustomerDueForTopUp(c);
                const isComplete = remaining === 0;

                // Next due date info
                let nextDueBadge = '';
                if (isComplete) {
                    nextDueBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700"><i class="fa-solid fa-check-circle mr-1"></i>30/30 Complete</span>`;
                } else if (isDue) {
                    nextDueBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 animate-pulse"><i class="fa-solid fa-bell mr-1"></i>Needs Top-Up Now</span>`;
                } else if (c.lastRechargeDate && c.lastChunkDays > 0) {
                    const nextDate = addDaysToISO(c.lastRechargeDate, c.lastChunkDays);
                    nextDueBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700">Next Top-Up: ${formatDisplayDate(nextDate)}</span>`;
                }

                const cardBorderClass = isDue
                    ? 'border-amber-300 ring-1 ring-amber-200/70'
                    : isComplete
                        ? 'border-emerald-200'
                        : 'border-slate-200/90';

                const progressColor = isComplete
                    ? 'bg-emerald-500'
                    : isDue
                        ? 'bg-amber-500'
                        : 'bg-blue-600';

                return `
                <article class="bg-white rounded-2xl p-4 shadow-sm border ${cardBorderClass} transition hover:shadow-md">
                    <!-- Top Row: Name, Book/App Badges & Status -->
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <div class="flex flex-wrap items-center gap-1.5 mb-1">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-50 border border-amber-200 text-amber-800 text-xs font-bold" title="Physical Book Number">
                                    <i class="fa-solid fa-book text-[10px]"></i> Book #${escapeHTML(c.bookNo)}
                                </span>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-50 border border-blue-200 text-blue-800 text-xs font-bold" title="WiFi App ID">
                                    <i class="fa-solid fa-mobile-screen text-[10px]"></i> App #${escapeHTML(c.appId)}
                                </span>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900 leading-snug">${escapeHTML(c.name)}</h3>
                        </div>
                        <div class="text-right shrink-0">
                            ${nextDueBadge}
                        </div>
                    </div>

                    <!-- Dates Row -->
                    <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
                        <span><i class="fa-regular fa-calendar-check text-slate-400 mr-1"></i>Paid: <strong class="text-slate-700">${formatDisplayDate(c.paymentDate)}</strong></span>
                        ${c.lastRechargeDate && c.rechargedDays > 0 ? `<span><i class="fa-solid fa-bolt text-emerald-500 mr-1"></i>Last Recharged: <strong class="text-slate-700">${formatDisplayDate(c.lastRechargeDate)}</strong> (${c.lastChunkDays || c.rechargedDays}d)</span>` : ''}
                    </div>

                    <!-- Progress & Remaining Balance Box -->
                    <div class="mt-3 bg-slate-50 rounded-xl p-3 border border-slate-200/70">
                        <div class="flex items-center justify-between text-xs mb-1.5">
                            <span class="font-semibold text-slate-600">Given: <strong class="text-slate-900">${c.rechargedDays}</strong> / ${c.totalDays} Days</span>
                            <span class="font-extrabold ${remaining > 0 ? 'text-amber-700' : 'text-emerald-700'} text-sm">
                                ${remaining > 0 ? `Remaining: ${remaining} Days` : 'All Days Recharged'}
                            </span>
                        </div>
                        <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
                            <div class="h-full ${progressColor} rounded-full transition-all duration-300" style="width: ${percent}%"></div>
                        </div>
                    </div>

                    <!-- Action Buttons Footer -->
                    <div class="mt-3.5 pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2">
                        <!-- Primary Recharge Action -->
                        ${remaining > 0 ? `
                        <button onclick="openRechargeModal('${c.id}')" class="flex-1 py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-xs transition">
                            <i class="fa-solid fa-bolt"></i>
                            <span>Give Recharge (+Days)</span>
                        </button>
                        ` : `
                        <button onclick="renewCycle('${c.id}')" class="flex-1 py-2.5 px-3 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-bold text-xs flex items-center justify-center gap-1.5 transition">
                            <i class="fa-solid fa-rotate-right"></i>
                            <span>Start New 30-Day Cycle</span>
                        </button>
                        `}

                        <!-- Edit & Remove Actions -->
                        <div class="flex items-center gap-1.5">
                            <button onclick="openCustomerModal('${c.id}')" class="p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition" title="Edit Customer">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button onclick="openRemoveModal('${c.id}')" class="p-2.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold transition" title="Remove Customer">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </article>
                `;
            }).join('');
        }

        // Escape HTML to prevent XSS
        function escapeHTML(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // =====================================================================
        // ADD / EDIT CUSTOMER MODAL LOGIC
        // =====================================================================
        function openCustomerModal(customerId = null) {
            const modal = document.getElementById('customer-modal');
            const form = document.getElementById('customer-form');
            form.reset();

            const today = getTodayISO();

            if (customerId) {
                const c = customers.find(item => item.id === customerId);
                if (!c) return;
                document.getElementById('customer-modal-title').textContent = 'Edit Customer Details';
                document.getElementById('modal-header-icon').className = 'fa-solid fa-user-pen';
                document.getElementById('edit-customer-id').value = c.id;
                document.getElementById('field-name').value = c.name;
                document.getElementById('field-book-no').value = c.bookNo;
                document.getElementById('field-app-id').value = c.appId;
                document.getElementById('field-payment-date').value = c.paymentDate;
                document.getElementById('field-total-days').value = c.totalDays;
                document.getElementById('field-recharged-days').value = c.rechargedDays;
                document.getElementById('field-last-recharge-date').value = c.lastRechargeDate || '';
                document.getElementById('field-last-chunk-days').value = c.lastChunkDays || 0;
            } else {
                document.getElementById('customer-modal-title').textContent = 'Add New Customer';
                document.getElementById('modal-header-icon').className = 'fa-solid fa-user-plus';
                document.getElementById('edit-customer-id').value = '';
                document.getElementById('field-payment-date').value = today;
                document.getElementById('field-total-days').value = 30;
                document.getElementById('field-recharged-days').value = 0;
                document.getElementById('field-last-recharge-date').value = today;
                document.getElementById('field-last-chunk-days').value = 0;
            }

            updateModalCalculation();
            modal.classList.remove('hidden');
        }

        function closeCustomerModal() {
            document.getElementById('customer-modal').classList.add('hidden');
        }

        function setModalRechargedDays(days) {
            document.getElementById('field-recharged-days').value = days;
            document.getElementById('field-last-chunk-days').value = days;
            if (days > 0 && !document.getElementById('field-last-recharge-date').value) {
                document.getElementById('field-last-recharge-date').value = getTodayISO();
            }
            updateModalCalculation();
        }

        function updateModalCalculation() {
            const total = parseInt(document.getElementById('field-total-days').value) || 30;
            const recharged = parseInt(document.getElementById('field-recharged-days').value) || 0;
            const remaining = Math.max(0, total - recharged);
            const previewEl = document.getElementById('modal-remaining-preview');

            if (remaining === 0) {
                previewEl.textContent = '0 Days (Complete)';
                previewEl.className = 'px-3 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-sm font-extrabold';
            } else {
                previewEl.textContent = `${remaining} Days Left`;
                previewEl.className = 'px-3 py-1 rounded-lg bg-amber-100 text-amber-800 text-sm font-extrabold';
            }
        }

        function saveCustomer(event) {
            event.preventDefault();

            const id = document.getElementById('edit-customer-id').value;
            const name = document.getElementById('field-name').value.trim();
            const bookNo = document.getElementById('field-book-no').value.trim();
            const appId = document.getElementById('field-app-id').value.trim();
            const paymentDate = document.getElementById('field-payment-date').value;
            const totalDays = Math.min(32, Math.max(1, parseInt(document.getElementById('field-total-days').value) || 30));
            const rechargedDays = Math.min(totalDays, Math.max(0, parseInt(document.getElementById('field-recharged-days').value) || 0));
            const lastRechargeDate = document.getElementById('field-last-recharge-date').value || (rechargedDays > 0 ? getTodayISO() : '');
            const lastChunkDays = parseInt(document.getElementById('field-last-chunk-days').value) || rechargedDays;

            if (id) {
                const index = customers.findIndex(c => c.id === id);
                if (index !== -1) {
                    customers[index] = {
                        ...customers[index],
                        name,
                        bookNo,
                        appId,
                        paymentDate,
                        totalDays,
                        rechargedDays,
                        lastRechargeDate,
                        lastChunkDays,
                        updatedAt: Date.now()
                    };
                    showToast('Customer updated!');
                }
            } else {
                const newCustomer = {
                    id: 'cust_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
                    name,
                    bookNo,
                    appId,
                    paymentDate,
                    totalDays,
                    rechargedDays,
                    lastRechargeDate,
                    lastChunkDays,
                    createdAt: Date.now(),
                    updatedAt: Date.now()
                };
                customers.unshift(newCustomer);
                showToast('New customer added!');
            }

            saveDataToStorage();
            closeCustomerModal();
            renderCustomers();
        }

        // =====================================================================
        // QUICK TOP-UP / RECHARGE MODAL LOGIC
        // =====================================================================
        function openRechargeModal(customerId) {
            const c = customers.find(item => item.id === customerId);
            if (!c) return;

            const remaining = Math.max(0, c.totalDays - c.rechargedDays);
            document.getElementById('recharge-customer-id').value = c.id;
            document.getElementById('recharge-customer-subtitle').textContent = `${c.name} (Book #${c.bookNo} • App #${c.appId})`;
            document.getElementById('rc-total').textContent = `${c.totalDays}d`;
            document.getElementById('rc-given').textContent = `${c.rechargedDays}d`;
            document.getElementById('rc-remaining').textContent = `${remaining}d`;

            // Default suggested chunk: up to 7 days or remaining if less than 7
            const suggested = Math.min(7, remaining);
            document.getElementById('recharge-add-days').value = suggested;
            document.getElementById('recharge-date-input').value = getTodayISO();

            updateRechargePreview();
            document.getElementById('recharge-modal').classList.remove('hidden');
        }

        function closeRechargeModal() {
            document.getElementById('recharge-modal').classList.add('hidden');
        }

        function selectRechargeChunk(days) {
            const id = document.getElementById('recharge-customer-id').value;
            const c = customers.find(item => item.id === id);
            if (!c) return;
            const remaining = Math.max(0, c.totalDays - c.rechargedDays);
            document.getElementById('recharge-add-days').value = Math.min(days, remaining > 0 ? remaining : 32);
            updateRechargePreview();
        }

        function updateRechargePreview() {
            const id = document.getElementById('recharge-customer-id').value;
            const c = customers.find(item => item.id === id);
            if (!c) return;

            const addDays = parseInt(document.getElementById('recharge-add-days').value) || 0;
            const newGiven = Math.min(c.totalDays, c.rechargedDays + addDays);
            const newRemaining = Math.max(0, c.totalDays - newGiven);

            document.getElementById('rc-new-remaining-preview').textContent =
                newRemaining === 0 ? '0 Days Left (Full Cycle Complete!)' : `${newRemaining} Days Left`;
        }

        function confirmAddRecharge() {
            const id = document.getElementById('recharge-customer-id').value;
            const index = customers.findIndex(item => item.id === id);
            if (index === -1) return;

            const addDays = parseInt(document.getElementById('recharge-add-days').value) || 0;
            if (addDays <= 0) {
                showToast('Please enter at least 1 day');
                return;
            }

            const rechargeDate = document.getElementById('recharge-date-input').value || getTodayISO();
            const c = customers[index];

            c.rechargedDays = Math.min(c.totalDays, c.rechargedDays + addDays);
            c.lastRechargeDate = rechargeDate;
            c.lastChunkDays = addDays;
            c.updatedAt = Date.now();

            saveDataToStorage();
            closeRechargeModal();
            renderCustomers();
            showToast(`Added +${addDays} days to ${c.name}!`);
        }

        // Start a fresh 30-day cycle when a completed customer pays again
        function renewCycle(customerId) {
            const index = customers.findIndex(c => c.id === customerId);
            if (index === -1) return;

            customers[index].paymentDate = getTodayISO();
            customers[index].rechargedDays = 0;
            customers[index].lastRechargeDate = '';
            customers[index].lastChunkDays = 0;
            customers[index].updatedAt = Date.now();

            saveDataToStorage();
            renderCustomers();
            showToast(`New 30-day cycle started for ${customers[index].name}!`);
        }

        // =====================================================================
        // REMOVE / ARCHIVE CUSTOMER LOGIC
        // =====================================================================
        function openRemoveModal(customerId) {
            const c = customers.find(item => item.id === customerId);
            if (!c) return;
            document.getElementById('remove-customer-id').value = c.id;
            document.getElementById('remove-modal-desc').textContent =
                `Remove "${c.name}" (Book #${c.bookNo}, App #${c.appId}) from your active list? You can restore them anytime from History.`;
            document.getElementById('remove-modal').classList.remove('hidden');
        }

        function closeRemoveModal() {
            document.getElementById('remove-modal').classList.add('hidden');
        }

        function confirmRemoveCustomer() {
            const id = document.getElementById('remove-customer-id').value;
            const index = customers.findIndex(c => c.id === id);
            if (index === -1) return;

            const [removed] = customers.splice(index, 1);
            removed.removedAt = getTodayISO();
            archivedCustomers.unshift(removed);

            saveDataToStorage();
            closeRemoveModal();
            renderCustomers();
            showToast(`${removed.name} moved to History`);
        }

        // Archive Modal Functions
        function openArchiveModal() {
            renderArchiveList();
            document.getElementById('archive-modal').classList.remove('hidden');
        }

        function closeArchiveModal() {
            document.getElementById('archive-modal').classList.add('hidden');
        }

        function renderArchiveList() {
            const container = document.getElementById('archive-list');
            if (archivedCustomers.length === 0) {
                container.innerHTML = `<p class="text-center text-xs text-slate-400 py-8">No removed customers in history.</p>`;
                return;
            }

            container.innerHTML = archivedCustomers.map(c => `
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-2">
                    <div>
                        <div class="text-xs font-bold text-slate-800">${escapeHTML(c.name)}</div>
                        <div class="text-[11px] text-slate-500">Book #${escapeHTML(c.bookNo)} • App #${escapeHTML(c.appId)} • Given ${c.rechargedDays}/${c.totalDays}d</div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button onclick="restoreCustomer('${c.id}')" class="px-2.5 py-1.5 rounded-lg bg-blue-600 text-white text-[11px] font-bold hover:bg-blue-700">Restore</button>
                        <button onclick="deleteArchivedForever('${c.id}')" class="p-1.5 rounded-lg text-red-500 hover:bg-red-50 text-xs" title="Delete Forever"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                </div>
            `).join('');
        }

        function restoreCustomer(id) {
            const index = archivedCustomers.findIndex(c => c.id === id);
            if (index === -1) return;
            const [restored] = archivedCustomers.splice(index, 1);
            restored.updatedAt = Date.now();
            customers.unshift(restored);
            saveDataToStorage();
            renderArchiveList();
            renderCustomers();
            showToast(`${restored.name} restored to active list!`);
        }

        function deleteArchivedForever(id) {
            archivedCustomers = archivedCustomers.filter(c => c.id !== id);
            saveDataToStorage();
            renderArchiveList();
            updateDashboardStats();
        }

        // =====================================================================
        // BACKUP, GMAIL SYNC & RESTORE LOGIC
        // =====================================================================
        function openBackupModal() {
            document.getElementById('backup-modal').classList.remove('hidden');
        }

        function closeBackupModal() {
            document.getElementById('backup-modal').classList.add('hidden');
        }

        function openInstallModal() {
            document.getElementById('install-modal').classList.remove('hidden');
        }

        function closeInstallModal() {
            document.getElementById('install-modal').classList.add('hidden');
        }

        // Format readable report + JSON backup and open Gmail
        function backupToGmail() {
            const today = formatDisplayDate(getTodayISO());
            let summaryLines = [
                `AS WiFi Service - Customer Backup (${today})`,
                `Total Active Customers: ${customers.length}`,
                `----------------------------------------`
            ];

            customers.forEach((c, idx) => {
                const rem = Math.max(0, c.totalDays - c.rechargedDays);
                summaryLines.push(
                    `${idx + 1}. ${c.name} | Book: #${c.bookNo} | App: #${c.appId} | Paid: ${formatDisplayDate(c.paymentDate)} | Given: ${c.rechargedDays}/${c.totalDays}d | Left: ${rem}d`
                );
            });

            summaryLines.push(`----------------------------------------`);
            summaryLines.push(`Backup Data Code (Keep safe):`);
            summaryLines.push(JSON.stringify({ customers, archivedCustomers }));

            const subject = encodeURIComponent(`AS WiFi Service Backup - ${today}`);
            const body = encodeURIComponent(summaryLines.join('\n'));

            // Open Gmail compose window directly
            const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&su=${subject}&body=${body}`;
            window.open(gmailUrl, '_blank');
            showToast('Opening Gmail backup...');
        }

        // Download JSON Backup File
        function downloadJSONBackup() {
            const payload = {
                app: 'AS WiFi Service',
                exportedAt: new Date().toISOString(),
                customers,
                archivedCustomers
            };
            const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `AS-WiFi-Backup-${getTodayISO()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Backup file downloaded!');
        }

        // Download CSV Spreadsheet
        function downloadCSVBackup() {
            const headers = ['Customer Name', 'Book No', 'App ID', 'Payment Date', 'Total Days', 'Recharged Days', 'Remaining Days', 'Last Recharge Date'];
            const rows = customers.map(c => {
                const rem = Math.max(0, c.totalDays - c.rechargedDays);
                return [
                    `"${c.name.replace(/"/g, '""')}"`,
                    `"${c.bookNo}"`,
                    `"${c.appId}"`,
                    formatDisplayDate(c.paymentDate),
                    c.totalDays,
                    c.rechargedDays,
                    rem,
                    formatDisplayDate(c.lastRechargeDate)
                ].join(',');
            });

            const csvContent = [headers.join(','), ...rows].join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `AS-WiFi-Customers-${getTodayISO()}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Excel CSV downloaded!');
        }

        // Restore from JSON Backup File
        function restoreFromJSONFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (Array.isArray(parsed.customers)) {
                        customers = parsed.customers;
                        archivedCustomers = Array.isArray(parsed.archivedCustomers) ? parsed.archivedCustomers : [];
                        saveDataToStorage();
                        renderCustomers();
                        closeBackupModal();
                        showToast(`Restored ${customers.length} customers successfully!`);
                    } else {
                        showToast('Invalid backup file format.');
                    }
                } catch (err) {
                    showToast('Could not read backup file.');
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }
    </script>
</body>
